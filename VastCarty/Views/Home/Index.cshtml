                    <li class="nav-item"><input class="search-bar form-control" type="search" placeholder="Search products..."></li>
                </ul>
                <div class="d-none d-lg-flex gap-3 align-items-center">
                    <a href="#" class="nav-link nav-icon"><i class="bi bi-person"></i></a>
                    <a href="#" class="nav-link nav-icon"><i class="bi bi-heart"></i></a>
                    <a href="#" class="nav-link nav-icon position-relative"><i class="bi bi-cart3"></i><span class="cart-badge">3</span></a>
