                <div class="col-6 col-md-4 col-lg-3"><div class="product-card position-relative"><div class="wishlist-icon"><i class="bi bi-heart"></i></div><img src="https://placehold.co/300x300/e2e8f0/1e293b?text=Jacket" class="product-img"><h6 class="fw-semibold mt-2">Leather Jacket</h6><div class="star">★★★★★</div><div class="price">KES 8,299</div><button class="btn btn-primary-custom btn-sm w-100 mt-2 rounded-pill">Add to cart</button></div></div>
                <div class="col-6 col-md-4 col-lg-3"><div class="product-card position-relative"><div class="wishlist-icon"><i class="bi bi-heart"></i></div><img src="https://placehold.co/300x300/e2e8f0/1e293b?text=Speaker" class="product-img"><h6 class="fw-semibold mt-2">Bluetooth Speaker</h6><div class="star">★★★★☆</div><div class="price">KES 12,500</div><button class="btn btn-primary-custom btn-sm w-100 mt-2 rounded-pill">Add to cart</button></div></div>
